{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/my-cron-function.py",
      "schedule": "0 * * * *" // Runs every hour
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/$1.py"
    }
  ]
}