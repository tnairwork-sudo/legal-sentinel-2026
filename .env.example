# ============================================================
# Legal Sentinel 2026 — Environment Variables Template
# ============================================================
# IMPORTANT: Copy this file to .env and fill in your real values.
#            NEVER commit your .env file to version control.
#
# Quick start:
#   cp .env.example .env
#   # Then edit .env with your actual API keys
# ============================================================

# ------------------------------------------------------------
# Gemini AI API
# Get your key at: https://aistudio.google.com/app/apikeys
# Used by: sentinel.py (lead analysis & strategy drafting)
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# Apollo Lead Database
# Get your key at: https://app.apollo.io/settings
# Used by: sentinel.py (lead discovery)
# ------------------------------------------------------------
APOLLO_API_KEY=your_apollo_api_key_here

# ------------------------------------------------------------
# Firebase Service Account
# Download JSON from: Firebase Console → Project Settings → Service Accounts
# Paste the ENTIRE JSON object as a single-line string (no newlines).
# Used by: sentinel.py, outreach.py, analytics.py
# Replace every placeholder value with data from your downloaded key file.
# ------------------------------------------------------------
FIREBASE_KEY_PATH={"type":"service_account","project_id":"tnlaw-87ba6","private_key_id":"your_key_id","private_key":"-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@tnlaw-87ba6.iam.gserviceaccount.com","client_id":"your_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40tnlaw-87ba6.iam.gserviceaccount.com"}

# ------------------------------------------------------------
# SendGrid Email API
# Get your key at: https://app.sendgrid.com/settings/api_keys
# Used by: outreach.py (email campaign delivery)
# ------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ------------------------------------------------------------
# Email Sender Identity
# Must match a verified sender in your SendGrid account.
# Verify at: https://app.sendgrid.com/settings/sender_auth
# ------------------------------------------------------------
SENDER_EMAIL=your_verified_sender@example.com
SENDER_NAME=Tushar Nair SC

# ------------------------------------------------------------
# Scheduler Configuration
# Used by: scheduler.py (automated lead collection)
# ------------------------------------------------------------
# How often to run the sentinel (in hours). Default: 6
SENTINEL_INTERVAL_HOURS=6

# Set to "1" to run an analytics snapshot after each sentinel run. Default: 0
RUN_ANALYTICS_AFTER=0

# ------------------------------------------------------------
# Outreach Rate Limiting
# Used by: outreach.py
# ------------------------------------------------------------
# Maximum emails to send per hour. Default: 20
RATE_LIMIT_PER_HOUR=20

# Maximum retry attempts for failed email sends. Default: 3
MAX_RETRIES=3

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------
NODE_ENV=production
ENVIRONMENT=production
