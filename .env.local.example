# ============================================================
# Legal Sentinel 2026 — Local Development Environment Template
# ============================================================
# IMPORTANT: Copy this file to .env and fill in your real values.
#            NEVER commit your .env file to version control.
#
# Quick start:
#   cp .env.local.example .env
#   # Then edit .env with your actual API keys
#
# This template enables extra debug output and uses safer
# default settings for local development.
# ============================================================

# ------------------------------------------------------------
# Gemini AI API
# Get your key at: https://aistudio.google.com/app/apikeys
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# Apollo Lead Database
# Get your key at: https://app.apollo.io/settings
# ------------------------------------------------------------
APOLLO_API_KEY=your_apollo_api_key_here

# ------------------------------------------------------------
# Firebase Service Account
# Download JSON from: Firebase Console → Project Settings → Service Accounts
# Paste the ENTIRE JSON object as a single-line string.
# ------------------------------------------------------------
FIREBASE_KEY_PATH={"type":"service_account","project_id":"tnlaw-87ba6","private_key_id":"","private_key":"","client_email":"","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":""}

# ------------------------------------------------------------
# SendGrid Email API
# Get your key at: https://app.sendgrid.com/settings/api_keys
# ------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ------------------------------------------------------------
# Email Sender Identity
# ------------------------------------------------------------
SENDER_EMAIL=your_verified_sender@example.com
SENDER_NAME=Tushar Nair SC

# ------------------------------------------------------------
# Scheduler — slower interval for local testing
# ------------------------------------------------------------
SENTINEL_INTERVAL_HOURS=1
RUN_ANALYTICS_AFTER=1

# ------------------------------------------------------------
# Outreach — conservative limits for local testing
# Keeps you well within SendGrid's free tier.
# ------------------------------------------------------------
RATE_LIMIT_PER_HOUR=5
MAX_RETRIES=2

# ------------------------------------------------------------
# Environment — development flags
# ------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development

# Set to "true" to print verbose debug logs in all scripts
DEBUG=true
